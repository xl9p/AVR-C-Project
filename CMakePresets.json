{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "avr-gnu",
      "displayName": "AVR GNU",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/avr-gnu",
      "toolchainFile": "${sourceDir}/cmake/toolchains/avr-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "avr-xc8",
      "displayName": "AVR XC8",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/avr-xc8",
      "toolchainFile": "${sourceDir}/cmake/toolchains/avr-xc8.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AVR_XC8_ROOT": "/opt/Microchip/xc8-v4.00"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "avr-gnu",
      "configurePreset": "avr-gnu"
    },
    {
      "name": "avr-xc8",
      "configurePreset": "avr-xc8"
    }
  ]
}